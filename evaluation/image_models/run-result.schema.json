{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HowLens image benchmark run/result v1; never product approval",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "model",
    "settings",
    "prompt",
    "prompt_sha256",
    "case_sha256",
    "reference_assets",
    "scene_step_ids",
    "text_sha256",
    "criteria_version",
    "sandbox_only",
    "status",
    "attempt",
    "paid_authorization",
    "measurement_source",
    "provider",
    "model_snapshot",
    "seed",
    "retry_reason",
    "billing_evidence",
    "panels",
    "latency_ms",
    "actual_cost_usd",
    "usage",
    "output_path",
    "http_status",
    "error_code",
    "request_id",
    "started_at_utc",
    "raw_dimensions",
    "normalized_dimensions",
    "normalization",
    "human_review",
    "product_safety_approval",
    "track"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "settings": {
      "type": "object"
    },
    "prompt": {
      "type": "string"
    },
    "prompt_sha256": {
      "type": "string"
    },
    "case_sha256": {
      "type": "string"
    },
    "reference_assets": {
      "type": "array"
    },
    "scene_step_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 9,
      "maxItems": 9
    },
    "text_sha256": {
      "type": "string"
    },
    "criteria_version": {
      "type": "string"
    },
    "sandbox_only": {
      "const": true
    },
    "status": {
      "enum": [
        "dry_run",
        "success",
        "api_error",
        "timeout",
        "cancelled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "paid_authorization": {
      "type": [
        "string",
        "null"
      ]
    },
    "measurement_source": {
      "enum": [
        "not_run",
        "offline",
        "live"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "retry_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "billing_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "step_id",
          "box"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "step_id": {
            "type": "string"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "actual_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "output_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_dimensions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "normalized_dimensions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "normalization": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_review": {
      "type": [
        "object",
        "null"
      ]
    },
    "product_safety_approval": {
      "const": false
    },
    "track": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "dry_run"
          }
        }
      },
      "then": {
        "properties": {
          "latency_ms": {
            "type": "null"
          },
          "actual_cost_usd": {
            "type": "null"
          },
          "measurement_source": {
            "const": "not_run"
          }
        }
      }
    }
  ]
}
